// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Pillar {
  PROCESS_AND_QUALITY
  DOMAIN_AND_BUSINESS
  TOOLS_AND_ENGINEERING
  AI_ENABLEMENT
  COMMUNICATION
}

enum Role {
  LEARNER
  ADMIN
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum AssessmentStatus {
  ASSIGNED // generated, waiting for the learner to open it
  IN_PROGRESS // opened — timer is running, server-side deadline set
  SUBMITTED // graded — by the learner, by the timer, or by repeated cheat flags
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  passwordSalt  String
  name          String
  role          Role     @default(LEARNER)
  designationId String?
  createdAt     DateTime @default(now())

  designation      Designation?    @relation(fields: [designationId], references: [id])
  progress         Progress[]
  assessments      Assessment[]
  certificates     Certificate[]
  moduleSelections LearnerModule[]
}

// Per-learner module visibility override. If a learner has any rows here,
// their curriculum is restricted to just those assignments; with none, they
// see the full curriculum for their designation (the original behavior).
// courseId lets admin pin a specific Course Library entry to this module for
// this particular learner (mandatory modules only, chosen in the UI).
model LearnerModule {
  id           String   @id @default(cuid())
  userId       String
  assignmentId String
  courseId     String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])

  @@unique([userId, assignmentId])
  @@index([userId])
  @@index([assignmentId])
  @@index([courseId])
}

// One row per learner x assignment — completion tracking
model Progress {
  id          String         @id @default(cuid())
  userId      String
  assignmentId String
  status      ProgressStatus @default(NOT_STARTED)
  evidenceNote String?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([userId, assignmentId])
  @@index([userId])
  @@index([assignmentId])
}

// A 25-question, 20-minute assessment generated from the learner's own
// curriculum. One row per attempt — admin can send a new one after a
// previous one is SUBMITTED, which generates a fresh random question set.
model Assessment {
  id              String            @id @default(cuid())
  learnerId       String
  assignedById    String
  status          AssessmentStatus  @default(ASSIGNED)
  durationMinutes Int               @default(20)
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  expiresAt       DateTime?
  submittedAt     DateTime?
  score           Int?
  totalQuestions  Int               @default(25)
  autoSubmitted   Boolean           @default(false) // true if ended by timer or cheat flags, not a manual submit

  learner     User                 @relation(fields: [learnerId], references: [id])
  questions   AssessmentQuestion[]
  events      AssessmentEvent[]
  certificate Certificate?

  @@index([learnerId])
}

// Issued once an admin confirms a learner's assessment score clears the bar.
// Snapshots name/designation/score at issue time so the certificate stays
// accurate even if that data changes later.
model Certificate {
  id                String   @id @default(cuid())
  learnerId         String
  assessmentId      String   @unique
  issuedById        String
  certificateNumber String   @unique
  learnerName       String
  designationName   String
  score             Int
  totalQuestions    Int
  issuedAt          DateTime @default(now())

  learner    User       @relation(fields: [learnerId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([learnerId])
}

model AssessmentQuestion {
  id              String  @id @default(cuid())
  assessmentId    String
  order           Int
  questionText    String
  optionsJson     String // JSON-encoded array of 4 option strings
  correctIndex    Int
  selectedIndex   Int? // learner's answer, null until submitted
  sourceModuleCode String // which module this question was drawn from

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
}

// Anti-cheat signal log: tab-switch, fullscreen exit, copy/paste attempts, etc.
model AssessmentEvent {
  id           String   @id @default(cuid())
  assessmentId String
  type         String
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
}

model Designation {
  id          String       @id @default(cuid())
  name        String       @unique
  roleStage   String
  jobFamily   String
  assignments Assignment[]
  courses     CourseDesignation[]
  users       User[]
}

model Module {
  // Module ID from the source sheet, e.g. "PT-040", "LM-037", "AI-ROVO"
  code              String       @id
  pillar            Pillar
  name              String
  capabilityTopics  String
  practicalOutput   String
  standard          String
  assignments       Assignment[]
}

// One row per Designation x Module pairing — the 8,032-row fact table
model Assignment {
  id              String   @id @default(cuid())
  designationId   String
  moduleCode      String
  requirement     String   // Mandatory / Deployment-specific / Choose one
  hours           Int
  freeLearning    String?
  freeLink        String?
  premiumLearning String?
  premiumLink     String?

  designation    Designation     @relation(fields: [designationId], references: [id])
  module         Module          @relation(fields: [moduleCode], references: [code])
  progress       Progress[]
  learnerModules LearnerModule[]

  @@index([designationId])
  @@index([moduleCode])
}

// The 210-row deduplicated Course Library sheet
model Course {
  id                     String   @id @default(cuid())
  provider               String
  name                   String
  accessType             String
  directLink             String?
  mappedModulesRaw        String   // raw text from "Mapped curriculum modules" — see roleStages/designations for parsed links
  qualityNote            String?
  validationStatus       String

  pillars     CoursePillar[]
  roleStages  CourseRoleStage[]
  designations CourseDesignation[]
  learnerModules LearnerModule[]
}

model CoursePillar {
  id       String @id @default(cuid())
  courseId String
  pillar   Pillar

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([pillar])
}

model CourseRoleStage {
  id        String @id @default(cuid())
  courseId  String
  roleStage String

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([roleStage])
}

model CourseDesignation {
  id            String @id @default(cuid())
  courseId      String
  designationId String

  course      Course      @relation(fields: [courseId], references: [id])
  designation Designation @relation(fields: [designationId], references: [id])

  @@index([courseId])
  @@index([designationId])
}
